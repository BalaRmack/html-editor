<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral black theme: no blue cast in surfaces, borders or popups. -->
    <Color x:Key="BackgroundColor">#090909</Color>
    <SolidColorBrush x:Key="Background" Color="#090909"/>
    <SolidColorBrush x:Key="Sidebar" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="Surface" Color="#141414"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#262626"/>
    <SolidColorBrush x:Key="PopupSurface" Color="#181818"/>
    <SolidColorBrush x:Key="Border" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Accent" Color="#7CE7C4"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#12332B"/>
    <SolidColorBrush x:Key="AccentInk" Color="#07231C"/>
    <SolidColorBrush x:Key="Danger" Color="#FF9AA2"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3A2226"/>
    <SolidColorBrush x:Key="Hero" Color="#10201B"/>
    <SolidColorBrush x:Key="OverlayBackground" Color="#101010"/>
    <SolidColorBrush x:Key="HoverTint" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Scrim" Color="#CC000000"/>
</ResourceDictionary>
