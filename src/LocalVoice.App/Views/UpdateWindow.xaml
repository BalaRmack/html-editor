<Window x:Class="LocalVoice.App.Views.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LocalVoice.App.Converters"
        Title="Обновление LocalVoice" Width="540" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True" ShowActivated="False" Topmost="True"
        Background="{DynamicResource Background}" Icon="pack://application:,,,/LocalVoice;component/Assets/LocalVoice.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" Closing="OnClosing" Loaded="OnLoaded">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="VisibleWhen"/>
        <conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True"/>
    </Window.Resources>
    <Grid x:Name="Root" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentSoft}">
                <Path Data="{StaticResource ExportIcon}" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Доступно обновление" FontSize="22" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Muted}"/>
                    <TextBlock Text=" → " Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding AvailableVersionText}" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Размер установщика:" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding AvailableSizeText}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14" Margin="0,14,0,0"
                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <TextBlock Text="Что нового" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding AvailableNotesText}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <!-- Offer: download / postpone / skip -->
            <Grid Visibility="{Binding ShowOfferButtons, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="DownloadButton" Content="Скачать" Command="{Binding DownloadUpdateCommand}" Style="{StaticResource Primary}" IsEnabled="{Binding CanDownload}" MinWidth="130" HorizontalAlignment="Left"/>
                <Button x:Name="PostponeButton" Grid.Column="1" Content="Отложить" Command="{Binding PostponeUpdateCommand}" IsEnabled="{Binding CanPostponeOrSkip}" Margin="10,0,0,0" ToolTip="Напомнить примерно через 24 часа"/>
                <Button x:Name="SkipButton" Grid.Column="2" Content="Пропустить" Command="{Binding SkipUpdateCommand}" Style="{StaticResource Quiet}" IsEnabled="{Binding CanPostponeOrSkip}" Margin="6,0,0,0" ToolTip="Не предлагать именно эту версию"/>
            </Grid>
            <!-- Downloading -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}">
                <Button Content="Отменить загрузку" Command="{Binding CancelDownloadCommand}"/>
                <TextBlock Text="Установщик проверяется по SHA-256…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <!-- Ready: explicit install, no silent restart -->
            <Grid Visibility="{Binding ShowReadyButtons, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="InstallButton" Content="Установить сейчас" Command="{Binding InstallUpdateCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="170"/>
                <Button Grid.Column="1" Content="Позже" Command="{Binding PostponeUpdateCommand}" Margin="10,0,0,0"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="4" Text="Аудио и распознанный текст не отправляются. Обновление скачивается только после нажатия «Скачать»." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
        <TextBlock Grid.Row="5" Text="Закрытие окна откладывает обновление. Пропуск действует только для выбранной версии." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </Grid>
</Window>
