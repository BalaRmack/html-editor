<Window x:Class="LocalVoice.App.Views.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LocalVoice.App.Converters" xmlns:controls="clr-namespace:LocalVoice.App.Controls"
        Title="LocalVoice overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" IsTabStop="False"
        ResizeMode="NoResize" SizeToContent="Manual" WindowStartupLocation="Manual" Width="352" Height="96"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="VisibleWhen"/>
        <conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True"/>
    </Window.Resources>
    <Grid x:Name="Root" Margin="16" Width="320" VerticalAlignment="Top">
        <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding SettingsStore.Current.OverlayScale}" ScaleY="{Binding SettingsStore.Current.OverlayScale}"/></Grid.LayoutTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Compact 320 × 64 capsule. The visible window includes a transparent shadow margin. -->
        <Border Height="64" CornerRadius="32" Background="{DynamicResource OverlayBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.38" Color="#000000"/></Border.Effect>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                    <Grid>
                        <Path Data="{StaticResource MicIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="{Binding ShowOverlayNormal, Converter={StaticResource VisibleWhen}}"/>
                        <Path Data="M 12 3 L 22 21 L 2 21 Z M 12 9 L 12 14 M 12 17 L 12 17.2" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Danger}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="{Binding HasOverlayError, Converter={StaticResource VisibleWhen}}"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Command="{Binding ToggleOverlayExpandedCommand}" Style="{StaticResource Quiet}" Focusable="False" Padding="4,0" MinHeight="48"
                        ToolTip="Показать распознанный текст или подробности">
                    <Grid>
                        <Grid Visibility="{Binding ShowOverlayNormal, Converter={StaticResource VisibleWhen}}">
                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                            <controls:WaveformView Height="28" Width="176" HorizontalAlignment="Center" Level="{Binding Level}" IsActive="{Binding IsListening}" BarBrush="{DynamicResource Accent}"/>
                            <TextBlock Grid.Row="1" Text="{Binding OverlayStatus}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Visibility="{Binding HasOverlayError, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Center">
                            <TextBlock Text="Не удалось начать" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Нажмите для подробностей" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="2" Command="{Binding ToggleListeningCommand}" Style="{StaticResource Primary}" Focusable="False" Width="32" Height="32" MinHeight="32" Padding="0" ToolTip="Остановить (Esc)"
                        Visibility="{Binding ShowOverlayNormal, Converter={StaticResource VisibleWhen}}">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentInk}"/>
                </Button>
                <Button Grid.Column="2" Command="{Binding DismissOverlayErrorCommand}" Style="{StaticResource Quiet}" Focusable="False" Width="32" Height="32" MinHeight="32" Padding="0" ToolTip="Скрыть"
                        Visibility="{Binding HasOverlayError, Converter={StaticResource VisibleWhen}}">
                    <Path Data="M 4 4 L 14 14 M 14 4 L 4 14" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </Border>

        <!-- Optional details stay out of the way until the user taps the capsule. -->
        <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="20" Padding="14" Background="{DynamicResource OverlayBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Visibility="{Binding IsOverlayExpanded, Converter={StaticResource VisibleWhen}}">
            <Grid>
                <StackPanel Visibility="{Binding ShowOverlayNormal, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding LiveText}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58"
                               Visibility="{Binding HasLiveText, Converter={StaticResource VisibleWhen}}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Говорите — слова появятся здесь. Фокус остаётся в вашем приложении." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Visibility="{Binding HasLiveText, Converter={StaticResource HiddenWhen}}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Command="{Binding CopyCommand}" IsEnabled="{Binding HasLiveText}" Content="Копировать" Style="{StaticResource Quiet}" Focusable="False" MinHeight="28" Padding="9,4" FontSize="11"/>
                        <TextBlock Text="{Binding HotkeySummary}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding HasOverlayError, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding OverlayError}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text}" MaxHeight="72"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Command="{Binding RetryDictationCommand}" Content="Повторить" Style="{StaticResource Primary}" Focusable="False" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                        <Button Command="{Binding OpenOverlaySettingsCommand}" Content="Настройки" Style="{StaticResource Quiet}" Focusable="False" MinHeight="28" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                        <Button Command="{Binding DismissOverlayErrorCommand}" Content="Скрыть" Style="{StaticResource Quiet}" Focusable="False" MinHeight="28" Padding="9,4" FontSize="11"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
