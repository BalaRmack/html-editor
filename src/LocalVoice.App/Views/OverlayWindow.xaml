<Window x:Class="LocalVoice.App.Views.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LocalVoice.App.Converters"
        Title="LocalVoice overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" IsTabStop="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources><conv:BoolToVisibilityConverter x:Key="VisibleWhen"/><conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True"/></Window.Resources>
    <Border Margin="18" Background="{DynamicResource OverlayBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="19" Padding="21,17" Width="610">
        <Border.LayoutTransform><ScaleTransform ScaleX="{Binding SettingsStore.Current.OverlayScale}" ScaleY="{Binding SettingsStore.Current.OverlayScale}"/></Border.LayoutTransform>
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.24" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoft}"><Path Data="{StaticResource MicIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                    <StackPanel Margin="10,0,0,0"><TextBlock Text="{Binding OverlayStatus}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="6" Padding="9,5"><TextBlock Text="{Binding HotkeySummary}" FontSize="11"/></Border>
                    <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="6" Padding="7,5" Margin="6,0,0,0"><TextBlock Text="Esc" FontSize="11"/></Border>
                </StackPanel>
            </Grid>
            <ProgressBar Grid.Row="1" Value="{Binding Level}" Maximum="1" Height="3" Margin="0,14,0,12"/>
            <Grid Grid.Row="2" MinHeight="48" MaxHeight="88">
                <TextBlock Text="{Binding LiveText}" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="{Binding HasLiveText, Converter={StaticResource VisibleWhen}}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="Говорите — слова появятся здесь. Фокус остаётся в вашем приложении." FontSize="16" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Visibility="{Binding HasLiveText, Converter={StaticResource HiddenWhen}}"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,13,0,0">
                <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CopyCommand}" IsEnabled="{Binding HasLiveText}" Content="Копировать" Style="{StaticResource Quiet}" Focusable="False" MinHeight="28" Padding="9,4" FontSize="11"/>
                    <Button Command="{Binding OpenExportCommand}" Click="OnExportClick" Content="Экспорт ↗" Style="{StaticResource Quiet}" Focusable="False" MinHeight="28" Padding="9,4" FontSize="11"/>
                    <Button Command="{Binding ToggleListeningCommand}" Content="Стоп" Style="{StaticResource Primary}" Focusable="False" MinHeight="28" Padding="13,4" Margin="6,0,0,0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
