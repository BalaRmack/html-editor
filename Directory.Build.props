<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.2.0</Version>
    <Authors>LocalVoice contributors</Authors>
    <Product>LocalVoice</Product>
    <Copyright>Copyright © 2026 LocalVoice contributors</Copyright>
    <Company>LocalVoice</Company>
    <RepositoryUrl>https://github.com/BalaRmack/html-editor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
